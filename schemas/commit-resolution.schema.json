{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/DI/schemas/commit-resolution.schema.json",
  "title": "Commit Resolution v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resolution_version",
    "resolution_id",
    "logical_operation_id",
    "effect_key",
    "resolution_status",
    "selected_next_action",
    "resolved_at",
    "evidence_references"
  ],
  "properties": {
    "resolution_version": {"type": "string", "enum": ["0.1"]},
    "resolution_id": {"type": "string", "minLength": 1},
    "logical_operation_id": {"type": "string", "minLength": 1},
    "effect_key": {"type": "string", "minLength": 1},
    "resolution_status": {
      "type": "string",
      "enum": ["committed", "not_committed", "still_unknown"]
    },
    "resolved_effect_id": {"type": "string", "minLength": 1},
    "selected_next_action": {
      "type": "string",
      "enum": [
        "ACCEPT_EXISTING_EFFECT",
        "RETRY_SAME_EFFECT_KEY",
        "STOP",
        "HUMAN_ESCALATION"
      ]
    },
    "next_effect_key": {"type": "string", "minLength": 1},
    "resolved_at": {"type": "string", "minLength": 1},
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
